---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
export async function getStaticPaths() { return (await getPosts()).map(post=>({params:{slug:post.file.split('/').pop().replace(/\.md$/,'')},props:{post}})); }
const { post } = Astro.props;
const { Content, frontmatter } = post;
---
<Base title={`${frontmatter.title} · Leo 的技术笔记`} description={frontmatter.description}><article class="article-page"><div class="page-head article-head"><a class="back" href="/posts/">← 所有文章</a><div class="eyebrow">{frontmatter.date} · {frontmatter.tags.join(' / ')}</div><h1>{frontmatter.title}</h1><p>{frontmatter.description}</p></div><div class="prose"><Content/></div></article></Base>

<style>
  .article-head { padding: 36px 0 20px; }
  .article-head .back { margin-bottom: 22px; }
  .article-head h1 { margin: 18px 0 16px; }
  .article-head > p { margin: 0; }
  .prose { max-width: none; margin: 0 0 64px; }
  .prose :global(h2:first-child) { margin-top: 12px; }
  .prose :global(table) {
    width: 100%;
    margin: 24px 0;
    border-collapse: collapse;
    border: 1px solid #cdd2c8;
    font-size: 0.94em;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }
  .prose :global(th), .prose :global(td) {
    border: 1px solid #cdd2c8;
    padding: 12px 16px;
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    background: #e9ede4;
    font-weight: 650;
  }
  .prose :global(tbody tr:nth-child(even)) { background: #f2f3ed; }
  @media (max-width: 700px) {
    .prose :global(th), .prose :global(td) { padding: 9px 10px; }
    .article-head { padding-top: 28px; }
    .article-head .back { margin-bottom: 18px; }
  }
</style>
