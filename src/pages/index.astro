---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';
const posts = await getPosts();
---
<Base><section class="hero"><div class="eyebrow"><span class="dot"></span> LEO'S NOTES · 技术与日常</div><h1>把实践写下来，<br/>让想法<span class="accent">慢慢生长。</span></h1><p class="intro">你好，我是 Leo。这里记录后端开发、AI 应用，<br class="desktop"/>以及把一个想法做成产品的过程。</p><a class="button" href="/posts/">阅读笔记 <span>↗</span></a><div class="hero-mark" aria-hidden="true">&lt;/&gt;<small>BUILD. LEARN. SHARE.</small></div></section><section><div class="section-heading"><h2>最近更新 <span>RECENT NOTES</span></h2><a href="/posts/">全部文章 ↗</a></div><PostList posts={posts.slice(0,5)}/></section><aside class="note"><span>✳</span><div><h3>从真实问题出发</h3><p>记录做过的尝试、遇到的问题，也记录尚未想明白的事。</p></div><a href="/about/">关于这个博客 ↗</a></aside></Base>
