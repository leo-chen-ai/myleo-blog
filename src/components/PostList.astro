---
import { postUrl } from '../lib/posts';
const { posts } = Astro.props;
---
<div class="post-list">{posts.map((post)=><article class="post-row"><time datetime={post.frontmatter.date}>{post.frontmatter.date}</time><div><a class="post-title" href={postUrl(post)}>{post.frontmatter.title}<span>↗</span></a><p>{post.frontmatter.description}</p><div class="tags">{post.frontmatter.tags.map(tag=><a href={`/tags/#${encodeURIComponent(tag)}`}>{tag}</a>)}</div></div></article>)}</div>
